# NANOLAB Edirne GLP AI Operasyonel Planlama & Numune Takip Sistemi — Örnek Ortam Değişkenleri (.env.example)

# Çalışma ortamı: development | production (production modunda /docs, /redoc ve /openapi.json kapatılır)
ENV=production
APP_ENV=production

# JWT İmza Anahtarı (Canlı sunucuda en az 32 karakterlik rastgele kriptografik anahtar kullanın)
SECRET_KEY=CHANGE_ME_TO_A_STRONG_256_BIT_PRODUCTION_SECRET_KEY_2026

# CORS İzin Verilen Alan Adları (Virgülle ayrılmış domain listesi veya geliştirme için *)
ALLOWED_ORIGINS=https://glp.nanolab.com.tr,http://localhost:8000,http://127.0.0.1:8000

# Veritabanı Bağlantısı (Varsayılan: backend/nanolab_glp.db — SQLite WAL Modu Aktif)
DATABASE_URL=sqlite:///nanolab_glp.db

# OpenAI GPT-4o Vision OCR Anahtarı (Opsiyonel — TIIS / CoA / FM.083 PDF ayrıştırma için)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Maksimum Dosya Yükleme Boyutu (MB)
MAX_UPLOAD_MB=25

# Yalnız başlıkları temizleyen güvenilir proxy ağları (virgülle ayrılmış CIDR).
# Boş: tüm yönlendirme başlıklarını yok say. Uvicorn: --no-proxy-headers.
TRUSTED_PROXY_CIDRS=
